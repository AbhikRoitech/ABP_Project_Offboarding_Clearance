<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m" controllerName="sap.abp.eSeparation.approve.views.RequestsMaster"
	xmlns:html="http://www.w3.org/1999/xhtml">

	<Page title="Employees" showFooter="false">
		<subHeader>
			<Bar design="Header">
				<contentMiddle>
					<SearchField placeholder="Search" showRefreshButton="{device>/isNoTouch}"
						liveChange="onLiveChangeList" search="onHandleRefresh" width="100%"></SearchField>
				</contentMiddle>
			</Bar>
		</subHeader>
		<content>
			<PullToRefresh id="pullId" visible="{device>/isTouch}"
				refresh="onHandleRefresh"></PullToRefresh>
			<List id="listReqId" mode="SingleSelectMaster" growing="true"
				growingThreshold="30" growingScrollToLoad="true" select="onListItemSelectEmp"
				items="{request>/results}">
				<items>
					<ObjectListItem title="{request>Ename}" type="Active"
						press="onListItemPress" number="{request>Pernr}" numberUnit="{request>Earqn}">
						<attributes>
							<ObjectAttribute
								text="{path: 'request>Begda',
									              formatter: 'sap.abp.eSeparation.approve.Common.formatDate'
									            }" />
						</attributes>
						<firstStatus>
							<ObjectStatus text="{request>Designation}" />
						</firstStatus>
					</ObjectListItem>
				</items>

			</List>
		</content>
		<footer>
			<Bar>
			</Bar>
		</footer>
	</Page>

</mvc:View>
